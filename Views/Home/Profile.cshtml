@{
    ViewData["Title"] = "My Profile";
}

<link rel="stylesheet" href="~/css/profile.css" />

<div class="full-page-container">
    <div class="folder-wrapper">
        <div class="folder-tab">
            <span>MY PROFILE</span>
        </div>

        <div class="folder-body">
            <div class="grid-layout">
                
                <div class="details-section">
                    <div class="photo-box">
                        <img src="~/images/profile.jpeg" alt="Angel Nicole S. Camara" class="profile-img" />
                    </div>
                    
                    <div class="info-list">
                        <div class="info-row">
                            <span class="label">NAME</span>
                            <span class="value">ANGEL NICOLE S. CAMARA</span>
                        </div>
                        <div class="info-row">
                            <span class="label">PROGRAM & YEAR</span>
                            <span class="value">BSCS 3-2</span>
                        </div>
                        <div class="info-row">
                            <span class="label">COURSE</span>
                            <span class="value">COMP 019 - AppDev</span>
                        </div>
                        <div class="info-row">
                            <span class="label">SCHOOL</span>
                            <span class="value">POLYTECHNIC UNIVERSITY OF THE PHILIPPINES</span>
                        </div>
                    </div>
                </div>

                <div class="skills-card">
                    <div class="skills-header">
                        <span class="status-dot"></span>
                        <span class="skills-title">SKILLS & EXPERIENCE</span>
                        <span class="close-btn">✕</span>
                    </div>
                    <ul class="skills-list">
                        <li>Project Workflow & Management</li>
                        <li>System & Content Quality Assurance</li>
                        <li>Technical Documentation</li>
                    </ul>
                </div>

                <div class="contact-card">
                    <div class="contact-header">
                        <span>CONTACT ME</span>
                        <span class="search-icon">🔍︎</span>
                    </div>
                    <div class="contact-details">
                        <p>&gt; Email: camara.angelns@gmail.com</p>
                        <p>&gt; Github: @@anc0-droid</p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>